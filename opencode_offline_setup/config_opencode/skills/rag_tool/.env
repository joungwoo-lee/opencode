# retriever_engine
# 예: 호스트에 9380 노출한 경우  사외망 172.21.137.193 사내망 12.80.214.246  BASE_URL 호스트는 NO_PROXY에 자동 병합됨.
RAG_BASE_URL=http://localhost:9380
RAG_API_KEY=ragflow-key
# 여러개면 콤마 구분 " , "
RAG_DATASET_IDS=knowledge-base01
# 없다면 비워두기
RAG_RERANK_ID=
RAG_VECTOR_WEIGHT=0.35
RAG_SIM_THRESH=0.1
RAG_PAGE_SIZE=64
RAG_TOPK=512
